<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZReader.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="PageBackground">#F7F7F2</Color>
            <Color x:Key="ReaderBackground">#FFFCF5</Color>
            <Color x:Key="PrimaryText">#1C1B1A</Color>
            <Color x:Key="SecondaryText">#68645F</Color>
            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource PageBackground}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
