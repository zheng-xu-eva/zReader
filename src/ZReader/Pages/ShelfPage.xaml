<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             x:Class="ZReader.Pages.ShelfPage"
             Title="书架">
    <Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label Text="我的书架" FontSize="28" TextColor="{StaticResource PrimaryText}" />
                <Label Text="本地加密保存" FontSize="14" TextColor="{StaticResource SecondaryText}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="导入 TXT" Clicked="OnImportClicked" />
        </Grid>
        <Label x:Name="StatusLabel" Grid.Row="1" TextColor="{StaticResource SecondaryText}" IsVisible="False" />
        <CollectionView x:Name="BooksView" Grid.Row="2" SelectionMode="Single" SelectionChanged="OnBookSelected">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                    <Label Text="书架为空" HorizontalTextAlignment="Center" FontSize="20" />
                    <Label Text="导入一本 TXT 开始阅读" HorizontalTextAlignment="Center" TextColor="{StaticResource SecondaryText}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#D4D0C8" StrokeShape="RoundRectangle 6" Padding="14" Margin="0,0,0,10" BackgroundColor="White">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Text="{Binding Title}" FontSize="18" TextColor="{StaticResource PrimaryText}" />
                            <Label Grid.Row="1" Text="{Binding SourceFileName}" FontSize="13" TextColor="{StaticResource SecondaryText}" />
                            <Label Grid.Column="1" Grid.RowSpan="2" Text="阅读" VerticalOptions="Center" TextColor="#315C50" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
